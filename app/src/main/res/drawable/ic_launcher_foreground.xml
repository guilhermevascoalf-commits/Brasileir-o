        </aapt:attr>
    </path>

    <!-- Shield Golden Border -->
    <path
        android:pathData="M54,26 L76,34 C76,60 54,78 54,78 C54,78 32,34 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#FFD600"
        android:fillColor="#00000000" />


    <path
        android:pathData="M54,36 A15,15 0 1,0 54,66 A15,15 0 1,0 54,36 Z"
        android:fillColor="#FFFFFF" />

    <!-- Center Pentagon of soccer ball -->
    <path
        android:pathData="M54,46 L58,49 L56.5,54 L51.5,54 L50,49 Z"
        android:fillColor="#212121" />


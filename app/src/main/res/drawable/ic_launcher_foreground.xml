    <!-- Golden Shield Badge -->
    <path
        android:pathData="M54,26 L76,34 C76,60 54,78 54,78 C54,78 32,60 32,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="26"
                android:endX="76"
                android:endY="78"
                android:type="linear">
                <item android:color="#00E676" android:offset="0.0" />
                <item android:color="#00897B" android:offset="1.0" />
